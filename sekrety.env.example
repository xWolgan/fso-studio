# Klucze API. Najprościej wpisać je w Studiu: Ustawienia (http://127.0.0.1:8100/ustawienia) — zapisują się tutaj.
# Ten plik NIE trafia do gita (.gitignore). Brak klucza = modele tego dostawcy są niedostępne.

# https://openrouter.ai/keys — tekst, obraz, wideo, mowa (setki modeli, jeden klucz)
OPENROUTER_API_KEY=
# https://fal.ai/dashboard/keys — obraz, wideo, muzyka, efekty dźwiękowe, mowa
FAL_KEY=
# https://cloud.higgsfield.ai/api-keys — wideo (Kling, WAN); format "id_klucza:sekret"
HF_KEY=
# https://kie.ai/api-key — obraz, wideo, mowa (Kling, Veo, Seedream, ElevenLabs…)
KIE_API_KEY=
# https://console.anthropic.com/settings/keys — tekst (Claude)
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys — tekst, obraz, mowa (ChatGPT, gpt-image, TTS)
OPENAI_API_KEY=
# https://aistudio.google.com/apikey — tekst, obraz (Gemini)
GEMINI_API_KEY=
